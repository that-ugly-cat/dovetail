# Copy to .env and fill in. .env is gitignored.

# Refuses to start without this. A default secret is the same as no secret.
JWT_SECRET=

# `local` (default) or `gateway`. Leave it local unless something is actually
# in front of the app: an app that believes an identity header with nothing in
# front of it lets in whoever can send that header.
AUTH_MODE=local

# Only meaningful in gateway mode. Under Docker this is the bridge gateway and
# NOT 127.0.0.1 — read the real value off the running container:
#   docker inspect dovetail -f '{{range .NetworkSettings.Networks}}{{.Gateway}}{{end}}'
BORANT_TRUSTED_PROXY=172.17.0.1

# The MCP transport checks Host and Origin against this.
PUBLIC_URL=https://dovetail.borant.eu

# Inside the container the mounted volume is /app/data, not /data.
DOVETAIL_DB=/app/data/dovetail.db

# A free account key multiplies the daily OpenAlex budget by ten.
OPENALEX_API_KEY=
DOVETAIL_MAILTO=

# Optional. Turns on stage 5a (the genre judgement) by making it possible to
# store per-user Anthropic keys encrypted. Without it that feature is off and
# everything else works unchanged — a missing key is a disabled feature, not a
# dead process. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=
